LOOKAP_API_KEYS=lk_live_aaa:starter,lk_live_bbb:pro,lk_live_ccc:team
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SITE_URL=https://lookap.saidev.codes

# Clerk (from the Clerk Dashboard, or `bunx clerk env pull`). Production (lookap.saidev.codes) uses the pk_live/sk_live pair of the production instance; local dev uses pk_test/sk_test.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Unkey (API Management): root key with create/verify/list/delete permissions, and the lookap keyspace id
UNKEY_ROOT_KEY=
UNKEY_API_ID=

# Polar (billing). Organization access token, webhook secret for /api/webhooks/polar, and one product id per plan and interval.
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_STARTER_MONTH=
POLAR_PRODUCT_STARTER_YEAR=
POLAR_PRODUCT_PRO_MONTH=
POLAR_PRODUCT_PRO_YEAR=
POLAR_PRODUCT_TEAM_MONTH=
POLAR_PRODUCT_TEAM_YEAR=
# Local only: skip billing and treat every signed-in user as Pro
# LOOKAP_FREE_MINT=1
